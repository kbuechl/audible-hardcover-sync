# Hardcover API token — get yours from your account settings page at hardcover.app
HARDCOVER_API_TOKEN=

# Optional: base URL of the web UI (used for links in notifications).
# The web UI has no login: use a LAN/VPN address, never a public one.
# e.g. http://192.168.1.10:8080
PUBLIC_URL=

# How often to run a sync pass (Go duration format, e.g. 6h, 30m)
SYNC_INTERVAL=6h

# Comma-separated shoutrrr notification URLs (Slack/Discord/email/etc). Leave blank to disable.
NOTIFY_URLS=

# Fuzzy title/author match threshold: strict (default), medium, loose, or a number 0-1.
MATCH_CONFIDENCE=strict

# Optional, opt-in: passphrase that encrypts the saved Audible login file.
# Leave blank to store it as plain JSON. Losing it means running `auth` again.
CREDENTIALS_KEY=
