# Hardcover API token — get yours from your account settings page at hardcover.app
HARDCOVER_API_TOKEN=

# Base URL this container is reachable at (used to build links in notifications)
# e.g. http://192.168.1.10:8080
PUBLIC_URL=

# How often to run a sync pass (Go duration format, e.g. 6h, 30m)
SYNC_INTERVAL=6h

# Comma-separated shoutrrr notification URLs (Slack/Discord/email/etc). Leave blank to disable.
NOTIFY_URLS=
