# Optional: Hardcover API token (hardcover.app -> Settings -> API).
# Leave blank to set it in the web UI instead.
HARDCOVER_API_TOKEN=

# Sync schedule, match strictness and the notification link address are
# set in the web UI under Setup -> Preferences.

# Optional, opt-in: passphrase that encrypts the saved Audible login file.
# Leave blank to store it as plain JSON. Losing it means running `auth` again.
CREDENTIALS_KEY=
